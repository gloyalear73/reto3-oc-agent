# Copia este archivo a .env y completa la clave. NUNCA subas .env al repositorio.
ANTHROPIC_API_KEY=

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
PORT=3000

# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TOKENS_GLOBAL=2000000
LLM_TIMEOUT_MS=60000

# Protección del enlace público (opcionales)
# Si se define, la API exige el header x-access-key (la interfaz la pide).
ACCESS_KEY=
# 1 en el despliegue público: sin ACCESS_KEY el servidor no arranca
REQUIRE_ACCESS_KEY=0
# Mensajes de chat por minuto y por IP
RATE_LIMIT_POR_MIN=20
# 1 si hay un proxy delante (Render): usa el último X-Forwarded-For como IP
TRUST_PROXY=0
