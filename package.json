{
  "name": "reto3-agente-ordenes-compra",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional que valida y crea órdenes de compra en un SAP simulado",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx demo.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:modulo": "tsx scripts/build-modulo.ts"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": ">=0.25.0",
    "typescript": "^5.6.0"
  }
}
